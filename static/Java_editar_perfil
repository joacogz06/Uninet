function validatenum() {
    var telefono = document.getElementById("TELEFONO").value;
    var mensaje = document.getElementById("teleerror");
    var regexTelefono = /^\+?\d{1,3}?[-.\s]?\(?\d{1,4}?\)?[-.\s]?\d{1,4}[-.\s]?\d{1,9}$/;

    if (telefono === "") {
        mensaje.innerHTML = "";
        errorColorFondo("TELEFONO");
        return false;
    } else if (!regexTelefono.test(telefono)) {
        mensaje.innerHTML = "El numero de telefono no es valido.";
        errorColorFondo("TELEFONO");
        return false;
    } else {
        mensaje.innerHTML = "";
        normalColorFondo("TELEFONO");
        return true;
    }
}

