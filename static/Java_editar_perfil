function openModal() { 
    document.getElementById('myModal').style.display = 'block';//deje de ser none y ocupe todo el tamanio dispo
}
function openModal1() {
    const modal = document.getElementById('error-message'); // Obtén el elemento directamente
    modal.innerHTML = "Completa los campos de manera correcta."; // Cambia el contenido del contenedor
    document.getElementById('myModal').style.display = 'block'; // Muestra el modal
}
function closeModal() { //vuelve el modal a como estaba
    document.getElementById('myModal').style.display = 'none';
}