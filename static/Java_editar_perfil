    var pass = document.getElementById("PASSWORDalu").value;
    var mensaje = document.getElementById("passerror")

    if (pass === "") {
        errorColorFondo("PASSWORDalu")
        mensaje.innerHTML=""
        return false
    }
    else if ((pass.match(/\d/g) || []).length < 3) {
        mensaje.innerHTML = "La contraseña debe tener al menos 3 números.";
        errorColorFondo("PASSWORDalu");
        return false;
    }    
    else {
        mensaje.innerHTML=""
        normalColorFondo("PASSWORDalu")
        return true;
    }
}
