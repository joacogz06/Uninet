    if (telefono === "") {
        mensaje.innerHTML = "";
        errorColorFondo("DNI");
        return false;
    } else if (!regexTelefono.test(telefono)) {
        mensaje.innerHTML = "El DNI no es valido.";
        errorColorFondo("DNI");
        return false;
    } else {
        mensaje.innerHTML = "";
        normalColorFondo("DNI");
        return true;
    }
}
