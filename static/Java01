function openModal() { 
    document.getElementById('myModal').style.display = 'block';//deje de ser none y ocupe todo el tamanio dispo   
}

function openModal1(response) {
    var modal = document.getElementById("myModal1");

    var modalContent = document.getElementById("modal_alumnos"); //modal_alumnos es el id de el <p> donde vamos a poner la info, osea el p q vamos a modificar
    response=response[0]
    modalContent.innerHTML = //nos estamos metiendo adentro del html y modifiando el contenido dentro
        ` 
        Alumno: ${response[1]} ${response[2]}<br>
        Teléfono: ${response[6]}<br>
        Gmail: ${response[3]}<br>
        DNI: ${response[5]}<br>
        Promedio: ${response[7]}<br>
        Carrera:  ${response[11]}<br>
        Ciudad:  ${response[12]}<br>
        Descripcion: ${response[10]}<br>
    `;
    //el signo peso $ es para que no lo tome litral 
    modal.style.display = "block";
}

