function info_alumno(id_alumno){
    var xhr = new XMLHttpRequest(); //es el objeto nativo en JavaScript que permite implementar AJAX. Con él, se pueden realizar solicitudes al servidor y manejar las respuestas de manera asíncrona o síncrona.
    xhr.open("POST", "/info_alumno", true);
    xhr.setRequestHeader("Content-Type", "application/json;charset=UTF-8"); //vamos a hablar en formato json
    var data = JSON.stringify({ "id": id_alumno});
    xhr.onload = function() { //cuando se ejecuta la funcion de la ruta info alumnno de manera existosa
        var response = JSON.parse(xhr.responseText); //extraer la respuesta que manda la ruta
            // Llamar a la función para abrir el modal con los datos de respuesta
        openModal1(response);
        }
    xhr.send(data);
    return true;
}

