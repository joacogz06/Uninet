function validateURL() {
    var url = document.getElementById("PWEB").value;
    var mensaje = document.getElementById("pweberror");
    var regexURL = /^(https?|ftp):\/\/[^\s/$.?#].[^\s]*$/;

    if (url === "") {
        mensaje.innerHTML = "";
        errorColorFondo("PWEB");
        return false;
    } else if (!regexURL.test(url)) {
        mensaje.innerHTML = "El URL no es valida.";
        errorColorFondo("PWEB");
        return false;
    } else {
        mensaje.innerHTML = "";
        normalColorFondo("PWEB");
        return true;
    }
}

function validatepass(){
    var pass = document.getElementById("PASSWORD").value;
    var mensaje = document.getElementById("passerror")

    if (pass === "") {
        errorColorFondo("PASSWORD")
        mensaje.innerHTML=""
        return false
    }
    else if (pass.length < 10){
        mensaje.innerHTML="La contrasena debe tener al menos 10 caracteres y 3 numeros"
        errorColorFondo("PASSWORD")
        return false
    }
    else if (!num_enteros("PASSWORD")){ 
        mensaje.innerHTML="La contrasena debe tener al menos 3 numeros"
        errorColorFondo("PASSWORD");
        return false
    }
    else {
        mensaje.innerHTML=""
        normalColorFondo("PASSWORD")
        return true;
    }
}

